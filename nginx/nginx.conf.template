upstream web_backend {
    server web:8000;
}

# HTTP — редирект на HTTPS + ACME challenge для certbot
server {
    listen 80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS
server {
    listen 443 ssl;
    server_name ${DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # Строгая транспортная безопасность: обещание браузеру ходить сюда только по
    # защищённому протоколу в течение года, вместе с поддоменами.
    #
    # ⚠️ ПРИЧИНА ЗДЕСЬ БЫЛА НАЗВАНА НЕВЕРНО, И ИСПРАВЛЕНА ПО ЗАПИСИ КОД-РЕВЬЮ
    # (06-REVIEW.md, IN-04). Стояло: «без него ПЕРВЫЙ запрос уходит по http, и
    # cookie успевает пройти открытым текстом ещё до редиректа». Это не так:
    # заголовок читается браузером только на ПОСЛЕДУЮЩИХ переходах — на первом
    # запросе его ещё никто не видел, и защитить этот запрос он не может.
    # Разрыв первого запроса закрывает `return 301` в блоке порта 80 выше, а не
    # эта строка. Заголовок нужен для ДРУГОГО: он снимает http-переход у всех
    # последующих обращений, включая набранные руками и пришедшие по старым
    # ссылкам, то есть убирает окно для перехвата редиректа посредником.
    # Директива верна и стоит верно — неверно было записанное основание (CR-03).
    #
    # ⚠️ ВО ВТОРОМ ШАБЛОНЕ (`nginx-http.conf.template`) ЭТОГО ЗАГОЛОВКА НЕТ, И
    # ЭТО РЕШЕНИЕ, А НЕ ЗАБЫВЧИВОСТЬ. Тот шаблон поднимается контейнером, когда
    # сертификата нет: он слушает только порт 80 и редиректа не делает. Обещание,
    # выданное оттуда, сервер не исполняет — и на год закрывает себе возможность
    # отвечать по незащищённому протоколу, то есть отключает продукт до
    # истечения срока обещания.
    #
    # ⚠️ ОТКАТ НЕ ОТМЕНЯЕТ УЖЕ ВЫДАННОЕ. Срок браузер ЗАПОМИНАЕТ: снятие
    # директивы не действует на тех, кто успел зайти. Ровно поэтому она стоит
    # только в том шаблоне, который сервер действительно исполняет.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    client_max_body_size 20M;

    # Sync-groups can take minutes for accounts with many WhatsApp groups
    location ~ ^/accounts/\d+/sync-groups$ {
        proxy_pass http://web_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 60s;
        proxy_read_timeout 600s;
        proxy_send_timeout 60s;
    }

    location /grafana/ {
        resolver 127.0.0.11 valid=10s;
        set $grafana_upstream grafana-broadcaster:3000;
        proxy_pass http://$grafana_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://web_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 60s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}
