upstream web_backend {
    server web:8000;
}

# HTTP-only — используется пока нет SSL-сертификата
server {
    listen 80;
    server_name ${DOMAIN};

    # ПОТОЛОК ТЕЛА ЗАПРОСА ВЫВЕДЕН ИЗ НАСТРОЕК ПРИЛОЖЕНИЯ, А НЕ ВЗЯТ «С ЗАПАСОМ».
    #
    # Формула: `max_images_per_ad` (умолчание 10) × `max_image_size_mb`
    # (умолчание 5) = 50 МБ полезных байтов, плюс запас на границы частей
    # составного запроса и на текстовые поля (список текущих ключей вложений
    # едет тем же запросом). 64M — это 50 МБ полезной нагрузки и ~14 МБ запаса.
    #
    # ⚠️ ПОДНЯЛ `max_images_per_ad` ИЛИ `max_image_size_mb` — ПОДНИМИ И ЭТО
    # ЗНАЧЕНИЕ. Связь держится не дисциплиной читателя, а машинно:
    # `tests/test_nginx_body_limit.py` читает ИСХОДНИК обоих шаблонов, сверяет
    # объявленный здесь потолок с произведением тех двух полей `Settings` и
    # краснит суиту при расхождении. Он же требует, чтобы ОБА шаблона объявляли
    # ОДНО значение: расхождение означало бы, что по HTTP и по HTTPS продукт
    # ведёт себя по-разному, а узнаётся это только на стенде.
    #
    # Почему потолок задан ЯВНО, а не оставлен умолчанию: до этой правки
    # директивы здесь не было ВОВСЕ, и какое значение при этом действовало —
    # НЕ ИЗМЕРЕНО. Вывод из ОТСУТСТВИЯ директивы был бы догадкой, а не фактом
    # (запись A1 разведки Фазы 12), поэтому значение называется, а не
    # выясняется. Это же закрывает угрозу «предел не объявлен» (T-12-08).
    #
    # Почему прежнего умолчания стало мало: с Фазы 12 партия вложений едет
    # ОДНИМ составным запросом, а не запросом на файл. 413 от прокси есть 4xx,
    # рантайм разметки на 4xx подмены не делает, и человек получил бы общую
    # плашку вместо причины, потеряв даже те файлы, что прошли бы поодиночке.
    #
    # Потолок приложения этой правкой НЕ сужается: отказ по числу вложений
    # остаётся решением сервера, а не парсера прокси.
    #
    # ⚠️ ЗАГОЛОВКА СТРОГОЙ ТРАНСПОРТНОЙ БЕЗОПАСНОСТИ ЗДЕСЬ ПО-ПРЕЖНЕМУ НЕТ, И
    # ЭТА ЗАПИСЬ ЕГО НЕ КАСАЕТСЯ: у него другой предмет и другое основание
    # (см. `nginx.conf.template`), решение о нём остаётся прежним.
    client_max_body_size 64M;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Sync-groups can take minutes for accounts with many WhatsApp groups
    location ~ ^/accounts/\d+/sync-groups$ {
        proxy_pass http://web_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 600s;
    }

    location /grafana/ {
        resolver 127.0.0.11 valid=10s;
        set $grafana_upstream grafana-broadcaster:3000;
        proxy_pass http://$grafana_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://web_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
