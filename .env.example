DATABASE_URL=postgresql+asyncpg://broadcaster:broadcaster@localhost:5432/broadcaster
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-in-production
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
WA_BRIDGE_URLS=["http://wa-bridge:3000"]

# Celery / billing
CELERY_BEAT_INTERVAL=30
BILLING_CACHE_TTL=60

# Message balance
FREE_MONTHLY_MESSAGES=10
MESSAGE_PACKAGES=[{"name":"100 сообщений","count":100,"price":"149.00"},{"name":"500 сообщений","count":500,"price":"599.00"},{"name":"1000 сообщений","count":1000,"price":"999.00"}]

# YooKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://example.com/billing

# S3 Storage
S3_ENDPOINT_URL=https://s3.your-provider.com
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_BUCKET_NAME=broadcaster
S3_REGION=
S3_PUBLIC_URL=https://s3.your-provider.com/broadcaster

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Domain (for nginx SSL)
DOMAIN=example.com
ADMIN_EMAIL=admin@example.com